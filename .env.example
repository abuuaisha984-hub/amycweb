# Local development uses SQLite; Netlify builds use PostgreSQL.
DATABASE_URL="file:../db/custom.db"

# NextAuth production secret: generate a unique random value of 32+ bytes.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://your-production-domain.example"

# Transactional password-recovery email (server-side only; sender domain must be verified with Resend).
RESEND_API_KEY=
EMAIL_FROM="AMYC <no-reply@your-verified-domain.example>"

# Optional separate key for hashing anonymous visitor cookies; falls back to NEXTAUTH_SECRET.
VISITOR_ANALYTICS_SECRET="replace-with-a-different-long-random-secret"

# Used only when initializing a fresh database with the seed command.
AMYC_INITIAL_ADMIN_EMAIL="admin@example.com"
AMYC_INITIAL_ADMIN_PASSWORD="replace-with-a-unique-password-of-14-or-more-characters"

# Supabase Storage (required for persistent production uploads)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=amyc-public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=amyc-public
